<Window x:Class="Zen.CardDesignerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Card Designer" Width="1180" Height="760" MinWidth="900" MinHeight="600" Background="#0B0D12" Foreground="#F4F6FA" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,12,12">
      <DrawingBrush.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,12,12"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#465064"><GeometryDrawing.Geometry><EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,330,0"><TextBlock Text="CARD DESIGNER" Foreground="#8B7CFF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
        <TextBlock Text="AGENT INSTRUCTIONS" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,10,0,4"/>
        <TextBox x:Name="AgentInstructionsInput" AcceptsReturn="True" TextWrapping="Wrap" Height="54" Padding="8,6"
                 ToolTip="These instructions are returned with every card of this type by zen-operator."/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal">
          <StackPanel Margin="0,0,12,0"><TextBlock Text="CARD COLOR" Foreground="#8992A5" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBox x:Name="CardFillInput" Width="78" Padding="7,4" TextChanged="AppearanceChanged"/><Button x:Name="CardFillPicker" Tag="CardFillInput" Width="26" Margin="4,0,0,0" Padding="0" BorderBrush="#8992A5" BorderThickness="1" Click="PickColor_Click" ToolTip="Choose card color"/></StackPanel></StackPanel>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="OUTLINE" Foreground="#8992A5" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBox x:Name="CardOutlineInput" Width="78" Padding="7,4" TextChanged="AppearanceChanged"/><Button x:Name="CardOutlinePicker" Tag="CardOutlineInput" Width="26" Margin="4,0,0,0" Padding="0" BorderBrush="#8992A5" BorderThickness="1" Click="PickColor_Click" ToolTip="Choose outline color"/></StackPanel></StackPanel>
          <StackPanel><TextBlock Text="WIDTH" Foreground="#8992A5" FontSize="9"/><ComboBox x:Name="OutlineWidthInput" Width="64" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
          <StackPanel Margin="0,0,12,0"><TextBlock Text="HEADER TEXT" Foreground="#8992A5" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBox x:Name="HeaderTextColorInput" Width="78" Padding="7,4" TextChanged="AppearanceChanged"/><Button x:Name="HeaderTextPicker" Tag="HeaderTextColorInput" Width="26" Margin="4,0,0,0" Padding="0" BorderBrush="#8992A5" BorderThickness="1" Click="PickColor_Click" ToolTip="Choose header text color"/></StackPanel></StackPanel>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="MAIN TEXT" Foreground="#8992A5" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBox x:Name="MainTextColorInput" Width="78" Padding="7,4" TextChanged="AppearanceChanged"/><Button x:Name="MainTextPicker" Tag="MainTextColorInput" Width="26" Margin="4,0,0,0" Padding="0" BorderBrush="#8992A5" BorderThickness="1" Click="PickColor_Click" ToolTip="Choose main text color"/></StackPanel></StackPanel>
          <StackPanel><TextBlock Text="TEXT BOX" Foreground="#8992A5" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBox x:Name="TextBoxColorInput" Width="78" Padding="7,4" TextChanged="AppearanceChanged"/><Button x:Name="TextBoxPicker" Tag="TextBoxColorInput" Width="26" Margin="4,0,0,0" Padding="0" BorderBrush="#8992A5" BorderThickness="1" Click="PickColor_Click" ToolTip="Choose text-box color"/></StackPanel></StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
    <TabControl Grid.Row="1" Background="#0B0D12" BorderThickness="0" SelectionChanged="DesignerTabs_SelectionChanged">
    <TabItem Header="Open card"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel>
        <TextBlock Text="ELEMENTS" Foreground="#8992A5" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
        <Button Tag="text" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,0,9" HorizontalContentAlignment="Stretch">
          <StackPanel IsHitTestVisible="False"><TextBlock Text="TEXT" Foreground="#8992A5" FontSize="9" Margin="0,0,0,4"/><TextBox Text="Text field" Padding="8,5"/></StackPanel>
        </Button>
        <Button Tag="label" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,0,9" HorizontalContentAlignment="Stretch">
          <StackPanel IsHitTestVisible="False"><TextBlock Text="LABEL" Foreground="#8992A5" FontSize="9" Margin="0,0,0,4"/><TextBlock Text="Informational text" TextWrapping="Wrap"/></StackPanel>
        </Button>
        <Button Tag="number" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,0,9" HorizontalContentAlignment="Stretch">
          <StackPanel IsHitTestVisible="False"><TextBlock Text="NUMBER" Foreground="#8992A5" FontSize="9" Margin="0,0,0,4"/><TextBox Text="0" Padding="8,5"/></StackPanel>
        </Button>
        <Button Tag="checkbox" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,0,9" HorizontalContentAlignment="Left">
          <CheckBox Content="Checkbox" IsHitTestVisible="False"/>
        </Button>
        <Button Tag="dropdown" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" HorizontalContentAlignment="Stretch">
          <StackPanel IsHitTestVisible="False"><TextBlock Text="DROPDOWN" Foreground="#8992A5" FontSize="9" Margin="0,0,0,4"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="Choice"/></ComboBox></StackPanel>
        </Button>
        <Button Tag="list" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,9,0,0" HorizontalContentAlignment="Stretch">
          <StackPanel IsHitTestVisible="False"><TextBlock Text="LIST" Foreground="#8992A5" FontSize="9" Margin="0,0,0,4"/><Border Background="#1D222C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="5" Padding="7,5"><TextBlock Text="• List item&#x0a;• Another item" FontSize="11"/></Border></StackPanel>
        </Button>
        <Button Tag="tags" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,9,0,0" HorizontalContentAlignment="Left">
          <Border IsHitTestVisible="False" Background="#514890" CornerRadius="4" Padding="7,3"><TextBlock Text="TAG" FontSize="9" FontWeight="Bold"/></Border>
        </Button>
        <Button Tag="cluster" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,9,0,0" HorizontalContentAlignment="Stretch">
          <Border IsHitTestVisible="False" Background="#302A55" BorderBrush="#8B7CFF" BorderThickness="1" CornerRadius="5" Padding="8,5"><TextBlock Text="CLUSTER" FontSize="9" FontWeight="Bold"/></Border>
        </Button>
        <Button Tag="files" PreviewMouseLeftButtonDown="Palette_PreviewMouseLeftButtonDown" PreviewMouseMove="Palette_PreviewMouseMove" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,9,0,0" HorizontalContentAlignment="Stretch">
          <Border IsHitTestVisible="False" Background="#1D222C" BorderBrush="#394151" BorderThickness="1" CornerRadius="5" Padding="8,5"><TextBlock Text="＋ Attach files" FontSize="11"/></Border>
        </Button>
        <TextBlock Text="Drag a real control onto the card." Foreground="#737D91" TextWrapping="Wrap" FontSize="10" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Background="#0E1117" BorderBrush="#262C38" BorderThickness="1" CornerRadius="14" Padding="18">
        <Border x:Name="OpenSurface" Width="600" HorizontalAlignment="Center" Background="#1D222C" BorderBrush="#394151" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <Canvas x:Name="DesignCanvas" Width="600" Background="{StaticResource DotGridBrush}" AllowDrop="True" Drop="DesignCanvas_Drop" DragOver="DesignCanvas_DragOver" ClipToBounds="True"/>
        </Border>
      </Border>
      <Border x:Name="Inspector" Grid.Column="4" Background="#161A22" BorderBrush="#394151" BorderThickness="1" CornerRadius="12" Padding="16" Visibility="Collapsed">
        <StackPanel><TextBlock Text="INSPECTOR" Foreground="#8B7CFF" FontSize="10" FontWeight="Bold"/>
          <TextBlock Text="NAME" Foreground="#8992A5" FontSize="9" Margin="0,15,0,4"/><TextBox x:Name="FieldName" TextChanged="InspectorChanged" Padding="8"/>
          <TextBlock Text="TYPE" Foreground="#8992A5" FontSize="9" Margin="0,12,0,4"/><ComboBox x:Name="FieldType" SelectionChanged="InspectorChanged"><ComboBoxItem Content="text"/><ComboBoxItem Content="label"/><ComboBoxItem Content="number"/><ComboBoxItem Content="checkbox"/><ComboBoxItem Content="dropdown"/><ComboBoxItem Content="list"/><ComboBoxItem Content="tags"/><ComboBoxItem Content="cluster"/><ComboBoxItem Content="files"/></ComboBox>
          <TextBlock Text="DEFAULT VALUE" Foreground="#8992A5" FontSize="9" Margin="0,12,0,4"/><TextBox x:Name="DefaultValue" TextChanged="InspectorChanged" Padding="8"/>
          <StackPanel x:Name="OptionsHost"><TextBlock Text="DROPDOWN OPTIONS (comma separated)" Foreground="#8992A5" FontSize="9" Margin="0,12,0,4"/><TextBox x:Name="OptionsInput" TextChanged="InspectorChanged" Padding="8"/></StackPanel>
          <CheckBox x:Name="ExpandedVisible" Content="Visible on expanded card" Checked="InspectorChanged" Unchecked="InspectorChanged" Margin="0,14,0,0"/>
          <CheckBox x:Name="CollapsedVisible" Content="Visible on compact card" Checked="InspectorChanged" Unchecked="InspectorChanged" Margin="0,8,0,0"/>
          <Button Content="Remove element" Foreground="#FF7F91" Click="RemoveElement_Click" Margin="0,18,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </Grid></TabItem>
    <TabItem Header="Expanded card"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel>
        <TextBlock Text="EXPANDED CARD" Foreground="#8992A5" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Arrange fields inside this fixed 228 × 168 surface. Content never makes the board card grow." Foreground="#737D91" TextWrapping="Wrap" FontSize="10"/>
        <CheckBox x:Name="ShrinkExpandedHeight" Content="Shrink height to content" Foreground="#D8DCE5" Margin="0,14,0,0" ToolTip="May make expanded cards shorter, but never taller than the designed surface."/>
      </StackPanel></Border>
      <Border Grid.Column="2" Background="#0E1117" BorderBrush="#262C38" BorderThickness="1" CornerRadius="14" Padding="24">
        <Border x:Name="ExpandedSurface" Width="228" Height="168" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#1D222C" BorderBrush="#394151" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <Canvas x:Name="ExpandedCanvas" Width="228" Height="168" Background="{StaticResource DotGridBrush}" ClipToBounds="True"/>
        </Border>
      </Border>
    </Grid></TabItem>
    <TabItem Header="Compact card"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#12151C" BorderBrush="#262C38" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel>
        <TextBlock Text="COMPACT ELEMENTS" Foreground="#8992A5" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Only compact-enabled fields appear inside this fixed 192 × 96 surface." Foreground="#737D91" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,12"/>
        <CheckBox x:Name="ShrinkCompactHeight" Content="Shrink height to content" Foreground="#D8DCE5" Margin="0,0,0,12" ToolTip="May make compact cards shorter, but never taller than the designed surface."/>
        <ItemsControl x:Name="CompactPalette"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" PreviewMouseMove="CompactPalette_PreviewMouseMove" Padding="9" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Grid.Column="2" Background="#0E1117" BorderBrush="#262C38" BorderThickness="1" CornerRadius="14" Padding="24">
        <Border x:Name="CompactSurface" Width="192" Height="96" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#1D222C" BorderBrush="#394151" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <Canvas x:Name="CompactCanvas" Width="192" Height="96" Background="{StaticResource DotGridBrush}" AllowDrop="True" Drop="CompactCanvas_Drop" DragOver="CompactCanvas_DragOver" ClipToBounds="True"/>
        </Border>
      </Border>
    </Grid></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Click="Cancel_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Save layout" Click="Save_Click" Padding="16,8" Background="#8B7CFF" Foreground="White"/></StackPanel>
  </Grid>
</Window>
