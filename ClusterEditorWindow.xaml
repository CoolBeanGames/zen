<Window x:Class="Zen.ClusterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cluster editor" Width="560" Height="760" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#0B0D12" Foreground="#F4F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="CLUSTER EDITOR" Foreground="#8B7CFF" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Group related tasks into one movable unit." Foreground="#8992A5" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="NAME" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="NameInput" Padding="9,7"/>
                <TextBlock Text="DESCRIPTION" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,14,0,5"/>
                <TextBox x:Name="DescriptionInput" Height="82" AcceptsReturn="True" TextWrapping="Wrap" Padding="9,7" VerticalContentAlignment="Top"/>
                <TextBlock Text="TAGS" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,14,0,5"/>
                <TextBox x:Name="TagsInput" Padding="9,7" ToolTip="Comma-separated tags"/>
                <TextBlock Text="COLOR" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,14,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ColorInput" Width="130" Padding="9,7"/>
                    <Button Content="Choose…" Click="ChooseColor_Click" Padding="12,7" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Text="STATE" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,16,0,7"/>
                <WrapPanel>
                    <CheckBox x:Name="AwaitingFeedbackInput" Content="Awaiting feedback" Foreground="#72E5A2" Margin="0,0,18,8"/>
                    <CheckBox x:Name="DoNotArchiveInput" Content="Do not archive" Foreground="#F0C574" Margin="0,0,18,8"/>
                    <CheckBox x:Name="LockedInput" Content="Locked" Foreground="#F0C574" Margin="0,0,0,8"/>
                </WrapPanel>

                <TextBlock Text="ACTIONS" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,12,0,7"/>
                <WrapPanel>
                    <CheckBox x:Name="CommitInput" Content="Commit" Margin="0,0,18,8"/>
                    <CheckBox x:Name="BuildInput" Content="Build" Margin="0,0,18,8"/>
                    <CheckBox x:Name="ReleaseInput" Content="Release" Margin="0,0,0,8"/>
                </WrapPanel>

                <TextBlock Text="REQUIREMENTS" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,14,0,7"/>
                <ItemsControl x:Name="RequirementsList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                            <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="RemoveRequirement_Click" Padding="7,3" Margin="6,0,0,0"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NewRequirementInput" Padding="8,5" KeyDown="NewRequirementInput_KeyDown"/>
                    <Button Grid.Column="1" Content="Add" Click="AddRequirement_Click" Padding="10,5" Margin="6,0,0,0"/>
                </Grid>

                <TextBlock Text="NOTES" Foreground="#8992A5" FontSize="9" FontWeight="Bold" Margin="0,16,0,7"/>
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Padding="8,6"/>
                            <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveNote_Click" Padding="7,3" Margin="6,0,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NewNoteInput" Padding="8,5" KeyDown="NewNoteInput_KeyDown"/>
                    <Button Grid.Column="1" Content="Add" Click="AddNote_Click" Padding="10,5" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock x:Name="ValidationText" Text="A cluster name is required." Foreground="#FF7F91" FontSize="11" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Save cluster" Click="Save_Click" Padding="16,8" Background="#8B7CFF" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
