<Window x:Class="Zen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zen settings" Width="720" Height="680" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Agent guidance, refresh behavior, and known projects." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="GLOBAL PROMPT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                <TextBlock Text="Used when Zen creates prompt.txt for a new project." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                <TextBox x:Name="PromptInput" Style="{StaticResource Field}" Height="250" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

                <TextBlock Text="RELOAD FREQUENCY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,20,0,7"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ReloadInput" Style="{StaticResource Field}" Width="90"/>
                    <TextBlock Text="seconds (5–3600)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Grid Margin="0,22,0,8">
                    <TextBlock Text="AGENTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="Recheck" Click="RecheckAgents_Click"/>
                </Grid>
                <ItemsControl x:Name="AgentsList" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,7">
                                <Grid>
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="Install" Tag="{Binding}" Click="InstallAgent_Click" Visibility="{Binding InstallVisibility}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="KNOWN PROJECTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,22,0,8"/>
                <ItemsControl x:Name="ProjectsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,7">
                                <Grid>
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="Remove" Tag="{Binding}" Click="RemoveProject_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SettingsValidation" Foreground="#FF7F91" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Apply" Click="Apply_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
