<Window x:Class="Zen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zen"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Zen" Width="1440" Height="900" MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewKeyDown="Window_PreviewKeyDown" LostMouseCapture="Window_LostMouseCapture"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="TinyPill" TargetType="Border">
            <Setter Property="Background" Value="#242A35"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="10">
                        <TextBlock Text="Z" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="zen" FontSize="19" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#222732" CornerRadius="5" Padding="7,3" Margin="9,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ProjectMenuButton" Style="{StaticResource IconButton}" Click="ProjectMenu_Click" ToolTip="Open project menu" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProjectNameText" Text="Choose project" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="7,-3,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" ToolTip="Reload task data" FontSize="17" Content="↻" Click="ReloadProject_Click" IsEnabled="False"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Search" FontSize="18" Content="⌕"/>
                    <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="6,0,12,0"/>
                    <Border Width="32" Height="32" Background="#2F3650" CornerRadius="16">
                        <TextBlock Text="ME" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="94"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="28,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Workspace" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Agent branches and personal work, in one place." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="ScrollLeft_Click" ToolTip="Scroll left" FontSize="17" Content="←" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Click="ScrollRight_Click" ToolTip="Scroll right" FontSize="17" Content="→" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Click="NewColumn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="17" Foreground="White" Margin="0,-2,7,0"/>
                            <TextBlock Text="New column" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BoardScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PanningMode="Both" PreviewMouseWheel="BoardScroller_PreviewMouseWheel"
                          PreviewMouseDown="BoardScroller_PreviewMouseDown" PreviewMouseMove="BoardScroller_PreviewMouseMove"
                          PreviewMouseUp="BoardScroller_PreviewMouseUp" LostMouseCapture="BoardScroller_LostMouseCapture"
                          Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Margin="28,0,18,0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:BoardColumn}">
                            <Grid Width="326" Margin="0,0,14,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Button Grid.Row="0" Tag="{Binding}" Click="AddTask_Click" HorizontalAlignment="Left" Margin="12,0,0,-1" Padding="12,7" Panel.ZIndex="2"
                                        Background="{StaticResource ColumnBrush}" Foreground="{StaticResource MutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="9,9,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="＋" Foreground="{TemplateBinding Foreground}" FontSize="15" Margin="0,-2,6,0"/>
                                                    <TextBlock Text="Add task" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tab" Property="Background" Value="#242A36"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            <Border Grid.Row="1" Width="326" Background="{StaticResource ColumnBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="68"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="17,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="17" Margin="0,-1,9,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                    <Border Style="{StaticResource TinyPill}" Margin="8,-2,0,0">
                                                        <TextBlock Text="{Binding Tasks.Count}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Clear" Tag="{Binding}" Click="ClearArchive_Click" ToolTip="Clear archived cards" Padding="8,5">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Content="•••" Tag="{Binding}" Click="ColumnMenu_Click" ToolTip="Column actions">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tasks}" Margin="11,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:TaskCard}">
                                                    <Border BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,9"
                                                            Cursor="Hand" PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown"
                                                            PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp"
                                                            PreviewMouseRightButtonUp="TaskCard_PreviewMouseRightButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                                                <Setter Property="BorderBrush" Value="#2A303D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBug}" Value="True">
                                                                        <Setter Property="Background" Value="#35171B"/>
                                                                        <Setter Property="BorderBrush" Value="#8D303B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#D69B45"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,10">
                                                                <ItemsControl ItemsSource="{Binding TagViews}" MaxWidth="210" HorizontalAlignment="Left">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding Color}" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding IndexLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="  🔒" Foreground="#E5AE58" FontSize="10">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                            <WrapPanel Margin="0,-2,0,7">
                                                                <Border Background="#273A31" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Commit}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="COMMIT" Foreground="#83D6A9" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#263749" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Build}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="BUILD" Foreground="#86BCEB" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#463822" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Release}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="RELEASE" Foreground="#F0C574" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#3D2946" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Merge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="MERGE" Foreground="#DCA2EB" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"/>
                                                            <TextBlock Text="{Binding Task}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" MaxHeight="72" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,10,0,0">
                                                                <ItemsControl.Style>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsControl.Style>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:CardFile}">
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Border CornerRadius="7" ClipToBounds="True" Height="132" Background="#11151C">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Image Source="{Binding AbsolutePath}" Stretch="UniformToFill"/>
                                                                            </Border>
                                                                            <Border Background="#202630" CornerRadius="6" Padding="9,7">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="📎" FontSize="12" Margin="0,0,7,0"/>
                                                                                    <TextBlock Text="{Binding Name}" Foreground="#B7BECC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Grid Margin="0,13,0,0">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="☑" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding Requirements.Count}" Foreground="#B6BDCC" FontSize="11"/>
                                                                    <TextBlock Text=" requirements" Foreground="#B6BDCC" FontSize="11"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="⌁" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding Files.Count}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border x:Name="ModalScrim" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" MouseDown="ModalScrim_MouseDown">
            <Border Width="430" Background="#171B23" BorderBrush="#303746" BorderThickness="1" CornerRadius="15" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="ModalCard_MouseDown">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ModalTitle" Text="Create a column" FontSize="20" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" Click="CancelModal_Click" FontSize="20" Padding="6,1"/>
                    </Grid>
                    <TextBlock x:Name="ModalSubtitle" Text="Connect work to a branch or keep it personal." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,20"/>
                    <TextBlock x:Name="NameLabel" Text="COLUMN NAME" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                    <TextBox x:Name="NameInput" Style="{StaticResource Field}" KeyDown="NameInput_KeyDown"/>

                    <TextBlock x:Name="ValidationText" Foreground="#FF7F91" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,23,0,0">
                        <Button Style="{StaticResource IconButton}" Content="Cancel" Click="CancelModal_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Create column" Click="ConfirmModal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="EditorBackdrop" Grid.RowSpan="2" Panel.ZIndex="90"
                Background="#72000000" Visibility="Collapsed" MouseDown="EditorBackdrop_MouseDown"/>

        <primitives:Popup x:Name="CardEditorPopup" AllowsTransparency="True" StaysOpen="False"
                          Placement="MousePoint" HorizontalOffset="12" VerticalOffset="10"
                          PopupAnimation="Fade" Closed="CardEditorPopup_Closed">
            <Border Width="500" MaxHeight="720" Background="#171B23" BorderBrush="#3A4252" BorderThickness="1" CornerRadius="13" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Grid Margin="0,0,0,17">
                        <StackPanel>
                            <TextBlock Text="Edit card" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EditIdentityText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" Click="CancelCardEdit_Click" FontSize="19" Padding="6,1"/>
                    </Grid>
                    <TextBlock Text="TITLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="EditTitleInput" Style="{StaticResource Field}"/>
                    <TextBlock Text="TAGS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <TextBox x:Name="EditTagsInput" Style="{StaticResource Field}" ToolTip="Separate tags with commas; press Tab to accept a suggestion"
                             TextChanged="EditTagsInput_TextChanged" PreviewKeyDown="EditTagsInput_PreviewKeyDown"/>
                    <ListBox x:Name="TagSuggestions" Visibility="Collapsed" MaxHeight="100" Background="#20252F" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" MouseLeftButtonUp="TagSuggestions_MouseLeftButtonUp"/>
                    <TextBlock Text="TASK PROMPT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <TextBox x:Name="EditTaskInput" Style="{StaticResource Field}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                    <TextBlock Text="REQUIREMENTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <ItemsControl x:Name="EditRequirementsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="RemoveRequirement_Click" Padding="6,2" MinHeight="24"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="NewRequirementInput" Style="{StaticResource Field}" KeyDown="NewRequirementInput_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="Add" Click="AddRequirement_Click" Margin="7,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,14,0,6">
                        <TextBlock Text="FILES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="＋ Attach files" HorizontalAlignment="Right" Click="AttachFiles_Click" Padding="8,4"/>
                    </Grid>
                    <ItemsControl x:Name="EditFilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20252F" CornerRadius="5" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" Foreground="#B7BECC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ACTIONS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,7"/>
                    <WrapPanel>
                        <CheckBox x:Name="EditCommitFlag" Content="Commit" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        <CheckBox x:Name="EditBuildFlag" Content="Build" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        <CheckBox x:Name="EditReleaseFlag" Content="Release" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        <CheckBox x:Name="EditMergeFlag" Content="Merge" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="EditValidationText" Text="A title is required." Foreground="#FF7F91" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource IconButton}" Content="Cancel" Click="CancelCardEdit_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply" Click="ApplyCardEdit_Click"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </primitives:Popup>

        <Canvas x:Name="DragOverlay" Grid.RowSpan="2" Panel.ZIndex="100" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
