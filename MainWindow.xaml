<Window x:Class="Zen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zen"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Zen" Icon="pack://application:,,,/Zen;component/Assets/ZenIcon.ico" Width="1440" Height="900" MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewKeyDown="Window_PreviewKeyDown" LostMouseCapture="Window_LostMouseCapture"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <ContextMenu x:Key="EditorTextMenu" x:Shared="False">
            <MenuItem Header="Undo" Command="ApplicationCommands.Undo"/>
            <MenuItem Header="Redo" Command="ApplicationCommands.Redo"/>
            <Separator/>
            <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
            <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
            <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
            <Separator/>
            <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll"/>
        </ContextMenu>
        <Style x:Key="EditorField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="ContextMenu" Value="{StaticResource EditorTextMenu}"/>
        </Style>
        <Style x:Key="TinyPill" TargetType="Border">
            <Setter Property="Background" Value="#242A35"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" ClipToBounds="True">
                        <Image Source="Assets/ZenIcon.ico" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="zen" FontSize="19" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#222732" CornerRadius="5" Padding="7,3" Margin="9,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ProjectMenuButton" Style="{StaticResource IconButton}" Click="ProjectMenu_Click" ToolTip="Open project menu" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProjectNameText" Text="Choose project" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="7,-3,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" ToolTip="Reload task data" FontSize="17" Content="↻" Click="ReloadProject_Click" IsEnabled="False"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Card Studio" FontSize="16" Content="▦" Click="CardStudio_Click"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Settings" FontSize="17" Content="⚙" Click="Settings_Click"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Search" FontSize="18" Content="⌕"/>
                    <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="6,0,12,0"/>
                    <Border Width="32" Height="32" Background="#2F3650" CornerRadius="16">
                        <TextBlock Text="ME" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="94"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="28,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Workspace" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Agent branches and personal work, in one place." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LaunchLatestExeButton" Style="{StaticResource IconButton}" Click="LaunchLatestExe_Click"
                            ToolTip="No build executable has been recorded" Content="Latest exe" Margin="0,0,4,0" IsEnabled="False"/>
                    <Button x:Name="LaunchLatestReleaseButton" Style="{StaticResource IconButton}" Click="LaunchLatestRelease_Click"
                            ToolTip="No release executable has been recorded" Content="Latest release" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button Style="{StaticResource IconButton}" Click="ScrollLeft_Click" ToolTip="Scroll left" FontSize="17" Content="←" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Click="ScrollRight_Click" ToolTip="Scroll right" FontSize="17" Content="→" Margin="0,0,12,0"/>
                    <Button x:Name="SignaturesButton" Style="{StaticResource IconButton}" Click="Signatures_Click" ToolTip="View project signatures" Content="Signatures" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="OpenProjectFolderButton" Style="{StaticResource IconButton}" Click="OpenProjectFolder_Click" ToolTip="Open the project folder" Content="Open folder" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="LaunchProjectButton" Style="{StaticResource IconButton}" Click="LaunchProject_Click" ToolTip="Launch an agent for this project" Content="Launch agent" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button Style="{StaticResource PrimaryButton}" Click="NewColumn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="17" Foreground="White" Margin="0,-2,7,0"/>
                            <TextBlock Text="New column" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BoardScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PanningMode="Both" PreviewMouseWheel="BoardScroller_PreviewMouseWheel"
                          PreviewMouseDown="BoardScroller_PreviewMouseDown" PreviewMouseMove="BoardScroller_PreviewMouseMove"
                          PreviewMouseUp="BoardScroller_PreviewMouseUp" LostMouseCapture="BoardScroller_LostMouseCapture"
                          ScrollChanged="BoardScroller_ScrollChanged"
                          Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Margin="28,0,18,0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:BoardColumn}">
                            <Grid Width="326" Margin="0,0,14,0" Tag="{Binding}" PreviewMouseRightButtonUp="Column_PreviewMouseRightButtonUp">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,0,0,-1" Panel.ZIndex="2" Tag="ColumnHeaderTabs">
                                <Button Tag="{Binding}" Click="AddTask_Click" HorizontalAlignment="Left" Padding="12,7"
                                        Background="{StaticResource ColumnBrush}" Foreground="{StaticResource MutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="9,9,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="＋" Foreground="{TemplateBinding Foreground}" FontSize="15" Margin="0,-2,6,0"/>
                                                    <TextBlock Text="Add" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tab" Property="Background" Value="#242A36"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Tag="{Binding}" Click="ToggleColumnCollapse_Click" Content="{Binding CollapseGlyph}" ToolTip="Collapse or expand column" Padding="10,7"
                                        Background="{StaticResource ColumnBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="5,0,0,0"/>
                                </StackPanel>
                            <Border Grid.Row="1" Width="326" CornerRadius="13" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ColumnBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True"><Setter Property="Height" Value="68"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="BorderBrush" Value="#E5AE58"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background" Value="#211C12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="68"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="17,0,12,0" PreviewMouseLeftButtonDown="ColumnHeader_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ColumnHeader_PreviewMouseLeftButtonUp" Cursor="SizeWE">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="17" Margin="0,-1,9,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                    <Border Style="{StaticResource TinyPill}" Margin="8,-2,0,0">
                                                        <TextBlock Text="{Binding Tasks.Count}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding LockGlyph}" Foreground="{StaticResource LockBrush}" FontSize="11" Margin="6,-1,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Clear" Tag="{Binding}" Click="ClearArchive_Click" ToolTip="Clear archived cards" Padding="8,5">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Content="•••" Tag="{Binding}" Click="ColumnMenu_Click" ToolTip="Column actions">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TaskView}" Margin="11,0">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ClusterHeader" Tag="{Binding Items[0].Cluster}" Background="{Binding Items[0].Cluster.Color}"
                                                                BorderBrush="#8B7CFF" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,1,0,7"
                                                                Cursor="SizeAll" PreviewMouseLeftButtonDown="ClusterHeader_PreviewMouseLeftButtonDown"
                                                                PreviewMouseLeftButtonUp="ClusterHeader_PreviewMouseLeftButtonUp"
                                                                PreviewMouseRightButtonUp="ClusterHeader_PreviewMouseRightButtonUp">
                                                            <Grid>
                                                                <TextBlock x:Name="CollapsedClusterName" Text="{Binding Items[0].Cluster.Name}"
                                                                           Foreground="White" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed"/>
                                                                <StackPanel x:Name="ExpandedClusterContent">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="◆" Foreground="White" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Items[0].Cluster.Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <Border Background="#55000000" CornerRadius="4" Padding="6,2" Margin="7,0,0,0">
                                                                                <TextBlock Text="{Binding ItemCount}" Foreground="White" FontSize="9"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Items[0].Cluster.CollapseGlyph}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <TextBlock x:Name="ClusterDescriptionPreview" Text="{Binding Items[0].Cluster.DescriptionPreview}"
                                                                               Foreground="#F7F8FC" FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                                                               MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                                                    <ItemsControl x:Name="ClusterTags" ItemsSource="{Binding Items[0].Cluster.Tags}" Margin="0,7,0,0">
                                                                        <ItemsControl.Style>
                                                                            <Style TargetType="ItemsControl">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Items[0].Cluster.Tags.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ItemsControl.Style>
                                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#56000000" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                                    <TextBlock Text="{Binding}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <WrapPanel Margin="0,7,0,-3">
                                                                        <Border Background="#64273A31" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.Flags.Commit}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="COMMIT" Foreground="#B6F0CE" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#643D2946" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.Flags.Merge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="MERGE" Foreground="#F0C9F7" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#64263749" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.Flags.Build}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="BUILD" Foreground="#BBDDFC" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#64463822" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.Flags.Release}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="RELEASE" Foreground="#FFE0A3" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#64273A31" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.IsAwaitingFeedback}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="FEEDBACK" Foreground="#B6F0CE" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#64463822" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.IsLocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="LOCKED" Foreground="#FFE0A3" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#64413A2D" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items[0].Cluster.DoNotArchive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                            <TextBlock Text="KEEP" Foreground="#FFE0A3" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Items[0].HasCluster}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].Cluster.IsAwaitingFeedback}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#53D68A"/><Setter Property="BorderThickness" Value="2"/>
                                                                            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#53D68A" BlurRadius="13" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Items[0].Cluster.DescriptionPreview}" Value="">
                                                                <Setter TargetName="ClusterDescriptionPreview" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Items[0].Cluster.IsCollapsed}" Value="True">
                                                                <Setter TargetName="ExpandedClusterContent" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CollapsedClusterName" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <Border x:Name="ClusterContainer" BorderThickness="0" CornerRadius="11">
                                                                        <StackPanel>
                                                                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                                            <ItemsPresenter x:Name="ClusterItems"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Items[0].HasCluster}" Value="True">
                                                                            <Setter TargetName="ClusterItems" Property="Margin" Value="7,0,0,0"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].Cluster.IsLocked}" Value="True">
                                                                            <Setter TargetName="ClusterContainer" Property="BorderBrush" Value="#D69B45"/>
                                                                            <Setter TargetName="ClusterContainer" Property="BorderThickness" Value="2"/>
                                                                            <Setter TargetName="ClusterContainer" Property="Padding" Value="4"/>
                                                                            <Setter TargetName="ClusterContainer" Property="Margin" Value="0,0,0,5"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].Cluster.IsCollapsed}" Value="True">
                                                                            <Setter TargetName="ClusterItems" Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:TaskCard}">
                                                    <Border BorderThickness="1" CornerRadius="10" Padding="0" Margin="0,0,0,9" ClipToBounds="True"
                                                            AllowDrop="True" DragEnter="TaskCard_DragEnter" DragOver="TaskCard_DragOver"
                                                            DragLeave="TaskCard_DragLeave" Drop="TaskCard_Drop"
                                                            Cursor="Hand" PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown"
                                                            PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp"
                                                            PreviewMouseRightButtonUp="TaskCard_PreviewMouseRightButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                                                <Setter Property="BorderBrush" Value="#2A303D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCustomCard}" Value="True">
                                                                        <Setter Property="Background" Value="{Binding CustomBackground}"/>
                                                                        <Setter Property="BorderBrush" Value="{Binding CustomBorderColor}"/>
                                                                        <Setter Property="BorderThickness" Value="{Binding CustomBorderThickness}"/>
                                                                        <Setter Property="Width" Value="{Binding CustomCardWidth}"/>
                                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBug}" Value="True">
                                                                        <Setter Property="Background" Value="#35171B"/>
                                                                        <Setter Property="BorderBrush" Value="#8D303B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#D69B45"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                                        <Setter Property="Background" Value="#202B35"/>
                                                                        <Setter Property="BorderBrush" Value="#3C6475"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                        <Setter Property="Background" Value="#2B171B"/>
                                                                        <Setter Property="BorderBrush" Value="#B44455"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCleanup}" Value="True">
                                                                        <Setter Property="Background" Value="#282331"/>
                                                                        <Setter Property="BorderBrush" Value="#8B7CFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMerge}" Value="True">
                                                                        <Setter Property="Background" Value="#172A25"/>
                                                                        <Setter Property="BorderBrush" Value="#53D68A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                        <Setter Property="Background" Value="#232C3D"/>
                                                                        <Setter Property="BorderBrush" Value="#4C8DFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAwaitingFeedback}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#53D68A"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                        <Setter Property="Effect">
                                                                            <Setter.Value><DropShadowEffect Color="#53D68A" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/></Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.RowSpan="2" Panel.ZIndex="2" Width="4" HorizontalAlignment="Left"
                                                                Background="{Binding Cluster.Color}" CornerRadius="3,0,0,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding HasCluster}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
