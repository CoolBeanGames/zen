                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="—  BREAK · AGENTS STOP HERE  —" HorizontalAlignment="Center" Foreground="#FF7F91" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBreak}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="—  CLEANUP · REMOVE OLD BUILDS  —" HorizontalAlignment="Center" Foreground="#B8AEFF" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCleanup}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="—  MERGE · SYNC TO ORIGIN  —" HorizontalAlignment="Center" Foreground="#72D6A5" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMerge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding IndexLabel}" Foreground="{Binding CustomHeaderTextColor}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,5">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel>
                                                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsBreak}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsCleanup}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsMerge}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <ItemsControl ItemsSource="{Binding TagViews}" MaxWidth="210" HorizontalAlignment="Left">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding Color}" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding IndexLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="  🔒" Foreground="#E5AE58" FontSize="10">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                            <WrapPanel Margin="0,-2,0,7">
                                                                <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                                                                <Border Background="#3B334A" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding KindLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="{Binding KindLabel}" Foreground="#CFC5FF" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#273A31" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Commit}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="COMMIT" Foreground="#83D6A9" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#263749" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Build}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="BUILD" Foreground="#86BCEB" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#463822" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Release}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="RELEASE" Foreground="#F0C574" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Background="#3D2946" CornerRadius="4" Padding="6,2" Margin="0,0,5,3">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Flags.Merge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="MERGE" Foreground="#DCA2EB" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </WrapPanel>
                                                            <Grid>
                                                                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20" Margin="0,0,72,0"/>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#413750" CornerRadius="4" Padding="6,2">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPriority}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock Text="{Binding PriorityLabel}" Foreground="#E0D7FF" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding CustomCompactFields}" Width="192" Height="{Binding CompactLayoutHeight}" HorizontalAlignment="Center" ClipToBounds="True">
                                                                <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCollapsed}" Value="True"/><Condition Binding="{Binding HasCustomCompactFields}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="True">
                                                                        <StackPanel x:Name="ValueView"><TextBlock x:Name="HeaderView" Text="{Binding Name}" Foreground="{Binding HeaderTextColor}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/><Border Background="{Binding TextBoxColor}" CornerRadius="4" Padding="5,3"><TextBlock Text="{Binding DisplayValue}" Foreground="{Binding MainTextColor}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></Border></StackPanel>
                                                                        <CheckBox x:Name="CheckView" Content="{Binding Name}" Foreground="{Binding MainTextColor}" IsChecked="{Binding IsChecked, Mode=OneWay}" FontSize="12" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                                        <TextBlock x:Name="LabelView" Text="{Binding DisplayValue}" Foreground="{Binding MainTextColor}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                                                        <Border x:Name="ImageView" Background="{Binding TextBoxColor}" CornerRadius="5" ClipToBounds="True" Visibility="Collapsed"><Image Source="{Binding ImagePath}" Stretch="UniformToFill"/></Border>
                                                                        <StackPanel x:Name="TagsView" Visibility="Collapsed">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding HeaderTextColor}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                                            <ItemsControl ItemsSource="{Binding TagViews}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Color}" CornerRadius="4" Padding="6,2" Margin="0,0,5,3"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                                            <TextBlock x:Name="NoTagsView" Text="No tags" Foreground="{Binding MainTextColor}" FontSize="11" Opacity="0.65"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="checkbox"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="CheckView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="label"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="LabelView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HideHeader}" Value="True"><Setter TargetName="HeaderView" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasImagePreview}" Value="True"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="ImageView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="tags"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="TagsView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasTags}" Value="True"><Setter TargetName="NoTagsView" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding CustomExpandedFields}" Width="228" Height="{Binding ExpandedLayoutHeight}" HorizontalAlignment="Center" ClipToBounds="True">
                                                                <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCollapsed}" Value="False"/><Condition Binding="{Binding HasCustomExpandedFields}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                                    <Grid Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="True">
                                                                        <StackPanel x:Name="ValueView"><TextBlock x:Name="HeaderView" Text="{Binding Name}" Foreground="{Binding HeaderTextColor}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/><Border Background="{Binding TextBoxColor}" CornerRadius="4" Padding="5,3"><TextBlock Text="{Binding DisplayValue}" Foreground="{Binding MainTextColor}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></Border></StackPanel>
                                                                        <CheckBox x:Name="CheckView" Content="{Binding Name}" Foreground="{Binding MainTextColor}" IsChecked="{Binding IsChecked, Mode=OneWay}" FontSize="12" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                                        <TextBlock x:Name="LabelView" Text="{Binding DisplayValue}" Foreground="{Binding MainTextColor}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                                                        <Border x:Name="ImageView" Background="{Binding TextBoxColor}" CornerRadius="5" ClipToBounds="True" Visibility="Collapsed"><Image Source="{Binding ImagePath}" Stretch="UniformToFill"/></Border>
                                                                        <StackPanel x:Name="TagsView" Visibility="Collapsed">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding HeaderTextColor}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                                            <ItemsControl ItemsSource="{Binding TagViews}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Color}" CornerRadius="4" Padding="6,2" Margin="0,0,5,3"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                                            <TextBlock x:Name="NoTagsView" Text="No tags" Foreground="{Binding MainTextColor}" FontSize="11" Opacity="0.65"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="checkbox"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="CheckView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="label"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="LabelView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HideHeader}" Value="True"><Setter TargetName="HeaderView" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasImagePreview}" Value="True"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="ImageView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="tags"><Setter TargetName="ValueView" Property="Visibility" Value="Collapsed"/><Setter TargetName="TagsView" Property="Visibility" Value="Visible"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasTags}" Value="True"><Setter TargetName="NoTagsView" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding Task}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" MaxHeight="72" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel Margin="0,8,0,0">
                                                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                                <TextBlock Text="{Binding StartedDate, StringFormat='Started · {0:MMM d, yyyy}'}" Foreground="{StaticResource MutedBrush}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasStartedDate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                                <TextBlock Text="{Binding DueDate, StringFormat='Due · {0:MMM d, yyyy}'}" Foreground="#E6B46B" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasDueDate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,10,0,0">
                                                                <ItemsControl.Style>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsControl.Style>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:CardFile}">
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Border CornerRadius="7" ClipToBounds="True" Height="132" Background="#11151C">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Image Source="{Binding AbsolutePath}" Stretch="UniformToFill"/>
                                                                            </Border>
                                                                            <Border Background="#202630" CornerRadius="6" Padding="9,7">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="📎" FontSize="12" Margin="0,0,7,0"/>
                                                                                    <TextBlock Text="{Binding Name}" Foreground="#B7BECC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Grid Margin="0,13,0,0">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCustomCard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasRequirements}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                                    <TextBlock Text="☑" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding RequirementProgress}" Foreground="#B6BDCC" FontSize="11"/>
                                                                    <TextBlock Text=" requirements" Foreground="#B6BDCC" FontSize="11"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="⌁" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding Files.Count}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Grid Grid.Row="1" Height="4">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasRequirements}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding RequirementProgressFraction, Converter={StaticResource FractionToStarConverter}}"/>
                                                                <ColumnDefinition Width="{Binding RequirementProgressFraction, Converter={StaticResource FractionToRemainderStarConverter}}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.ColumnSpan="2" Background="#12151C"/>
                                                            <Border Grid.Column="0" Background="{StaticResource AccentBrush}"/>
                                                        </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border x:Name="ModalScrim" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed" MouseDown="ModalScrim_MouseDown">
            <Border Width="430" Background="#171B23" BorderBrush="#303746" BorderThickness="1" CornerRadius="15" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="ModalCard_MouseDown">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ModalTitle" Text="Create a column" FontSize="20" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" Click="CancelModal_Click" FontSize="20" Padding="6,1"/>
                    </Grid>
                    <TextBlock x:Name="ModalSubtitle" Text="Connect work to a branch or keep it personal." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,20"/>
                    <TextBlock x:Name="NameLabel" Text="COLUMN NAME" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                    <TextBox x:Name="NameInput" Style="{StaticResource Field}" KeyDown="NameInput_KeyDown"/>

                    <TextBlock x:Name="ValidationText" Foreground="#FF7F91" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,23,0,0">
                        <Button Style="{StaticResource IconButton}" Content="Cancel" Click="CancelModal_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Create column" Click="ConfirmModal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Grid x:Name="CardEditorHost" Grid.RowSpan="2" Panel.ZIndex="90" Visibility="Collapsed">
            <Border x:Name="EditorBackdrop" Background="#72000000" MouseDown="EditorBackdrop_MouseDown"/>
            <Border x:Name="EditorShell" Width="500" MaxHeight="720" Background="#171B23" BorderBrush="#3A4252" BorderThickness="1" CornerRadius="13" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    PreviewKeyDown="CardEditor_PreviewKeyDown">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="EditorScroller" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseDown="EditorScroller_PreviewMouseDown" PreviewMouseMove="EditorScroller_PreviewMouseMove"
                              PreviewMouseUp="EditorScroller_PreviewMouseUp" LostMouseCapture="EditorScroller_LostMouseCapture">
                <Border Width="{Binding ViewportWidth, ElementName=EditorScroller}" Padding="0,0,12,0">
                <StackPanel>
                    <Grid Margin="0,0,0,17">
                        <StackPanel Margin="0,0,170,0">
                            <WrapPanel>
                                <TextBlock x:Name="EditHeading" Text="Edit card" FontSize="18" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <CheckBox x:Name="EditAwaitingFeedbackFlag" Content="Awaiting feedback" Foreground="#72E5A2"
                                          VerticalAlignment="Center" ToolTip="The agent has left a note and needs user feedback before continuing this card."/>
                            </WrapPanel>
                            <TextBlock x:Name="EditIdentityText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                            <TextBlock x:Name="EditCustomAgentInstructionsText" Visibility="Collapsed" Foreground="#AEB6C7" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="72" ToolTip="Instructions given to agents when they read this custom card"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButton}" Content="×" Click="CancelCardEdit_Click" FontSize="19" Padding="6,1"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="EditStandardFields">
                        <TextBlock Text="TITLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="EditTitleInput" Style="{StaticResource EditorField}"/>
                        <TextBlock x:Name="EditPromptLabel" Text="TASK PROMPT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                        <TextBox x:Name="EditTaskInput" Style="{StaticResource EditorField}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <Border x:Name="EditCustomCardHost" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0">
                        <Canvas x:Name="EditCustomCardCanvas" Background="Transparent" ClipToBounds="True"/>
                    </Border>
                    <StackPanel x:Name="EditAdvancedFields">
                    <TextBlock Text="CLUSTER" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <TextBox x:Name="EditClusterInput" Style="{StaticResource EditorField}" ToolTip="Choose an existing cluster or type a name to create one"
                             TextChanged="EditClusterInput_TextChanged" PreviewKeyDown="EditClusterInput_PreviewKeyDown"/>
                    <ListBox x:Name="ClusterSuggestions" Visibility="Collapsed" MaxHeight="100" Background="#20252F" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" MouseLeftButtonUp="ClusterSuggestions_MouseLeftButtonUp"/>
                    <TextBlock Text="TAGS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <TextBox x:Name="EditTagsInput" Style="{StaticResource EditorField}" ToolTip="Separate tags with commas; press Tab to accept a suggestion"
                             TextChanged="EditTagsInput_TextChanged" PreviewKeyDown="EditTagsInput_PreviewKeyDown"/>
                    <ListBox x:Name="TagSuggestions" Visibility="Collapsed" MaxHeight="100" Background="#20252F" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" MouseLeftButtonUp="TagSuggestions_MouseLeftButtonUp"/>
                    <TextBlock Text="INFO" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <CheckBox x:Name="EditBugFlag" Content="Bug — priority defect" Foreground="{StaticResource TextBrush}"/>
                    <CheckBox x:Name="EditInProgressFlag" Content="In progress — agent is working" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                    <StackPanel x:Name="EditCustomFieldsHost" Visibility="Collapsed">
                        <TextBlock Text="CUSTOM FIELDS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                        <ItemsControl x:Name="EditCustomFieldsList"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Name}" Foreground="#B7BECC" FontSize="10" Margin="0,0,0,4"/><TextBox Style="{StaticResource EditorField}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <TextBlock Text="REQUIREMENTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
                    <ItemsControl x:Name="EditRequirementsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#292335" CornerRadius="5" Padding="7,5" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IndexLabel}" Foreground="#FF6070" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBox Grid.Column="2" Style="{StaticResource EditorField}" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="RemoveRequirement_Click" Padding="6,2" MinHeight="24"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="NewRequirementInput" Style="{StaticResource EditorField}" KeyDown="NewRequirementInput_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="Add" Click="AddRequirement_Click" Margin="7,0,0,0"/>
                    </Grid>

                    <TextBlock Text="NOTES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                    <TextBlock Text="Reference a requirement with [1], [2], and so on." Foreground="#737D91" FontSize="10" Margin="0,0,0,7"/>
                    <ItemsControl x:Name="EditNotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20252F" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <local:RequirementReferenceEditor NoteText="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            AcceptsReturn="True" MinHeight="48" Padding="8,6" Background="#0E1117"
                                                                            Foreground="#F4F6FA" BorderBrush="#262C38" BorderThickness="1"
                                                                            VerticalScrollBarVisibility="Auto"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="RemoveNote_Click" Padding="6,2" MinHeight="24" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="NewNoteInput" Style="{StaticResource EditorField}" KeyDown="NewNoteInput_KeyDown"
                                 ToolTip="Enter adds the note; Shift+Enter starts a new line"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="Add" Click="AddNote_Click" Margin="7,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,14,0,6">
                        <TextBlock Text="FILES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="＋ Attach files" HorizontalAlignment="Right" Click="AttachFiles_Click" Padding="8,4"/>
                    </Grid>
                    <ItemsControl x:Name="EditFilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20252F" CornerRadius="5" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" Foreground="#B7BECC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="SCHEDULE &amp; PRIORITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,16,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="STARTED" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,4"/><DatePicker x:Name="EditStartedDate"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="DUE" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,4"/><DatePicker x:Name="EditDueDate"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="PRIORITY" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,4"/><ComboBox x:Name="EditPriority"><ComboBoxItem Content="None"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Critical"/></ComboBox></StackPanel>
                    </Grid>

                    <TextBlock Text="ACTIONS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,7"/>
                    <WrapPanel>
                        <CheckBox x:Name="EditCommitFlag" Content="Commit" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        <CheckBox x:Name="EditBuildFlag" Content="Build" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        <CheckBox x:Name="EditReleaseFlag" Content="Release" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        <CheckBox x:Name="EditMergeFlag" Content="Merge" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    </StackPanel>
                </StackPanel>
                </Border>
                </ScrollViewer>
                <Border Grid.Row="1" Background="#171B23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                    <TextBlock x:Name="EditValidationText" Text="A title is required." Foreground="#FF7F91" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <Grid>
                        <Button x:Name="EditCustomCardTypeButton" Style="{StaticResource IconButton}" Content="Edit card design…"
                                Click="EditCustomCardType_Click" Padding="9,5" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="Cancel" Click="CancelCardEdit_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Apply" Click="ApplyCardEdit_Click"/>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <Canvas x:Name="DragOverlay" Grid.RowSpan="2" Panel.ZIndex="100" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
